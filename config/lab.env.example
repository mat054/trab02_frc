# Parâmetros compartilhados do laboratório (contrato da Fase 0).
# Copiar para config/lab.env e ajustar X, Y e o MAC real. lab.env não vai para o Git.

# Interfaces do roteador FreeBSD (confirmar com ifconfig)
WAN_IF=vtnet0
LAN_IF=vtnet1

# WAN: rede de acesso do laboratório 192.168.X.0/24
WAN_IP=192.168.X.Y
WAN_GATEWAY=192.168.X.1

# LAN /16 em faixa privada (RFC 1918); não usar 192.168.0.0/16, sobrepõe a WAN
LAN_IP=10.20.0.1
LAN_CIDR=10.20.0.0/16
LAN_NETMASK=255.255.0.0

# DHCP (dnsmasq) ouvindo só em LAN_IF
DHCP_START=10.20.0.100
DHCP_END=10.20.0.200
DHCP_LEASE=12h
# DNS entregue aos clientes: 192.168.X.1 ou o informado pelo professor (164.41.101.4 / 164.41.101.11)
DNS_IP=192.168.X.1

# Cliente reservado: recebe sempre RESERVED_IP e roda o servidor TCP do DNAT
# MAC do cliente de desenvolvimento (VM FreeBSD-Cliente-LAN no UTM); no LDS, trocar pelo MAC real
RESERVED_MAC=52:54:00:4c:41:10
RESERVED_IP=10.20.0.10
RESERVED_NAME=cliente-reservado

# DNAT: TCP WAN:80 -> RESERVED_IP:8080
DNAT_WAN_PORT=80
DNAT_LAN_PORT=8080
